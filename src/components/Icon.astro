---
// Functional line icons, 1.5px stroke in the current text colour (concept.md «Зображення»). Decorative by default.
type Name = "phone" | "map" | "instagram" | "facebook" | "arrow" | "arrow-down" | "crown" | "menu" | "close" | "chevron";
interface Props { name: Name; size?: number; class?: string; }
const { name, size = 20, class: cls } = Astro.props;
---
<svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {name === "phone" && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11.5 11.5 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.5 2.5C9.4 19.5 3.5 13.6 3.5 6A2.5 2.5 0 0 1 5 3.5Z" />}
  {name === "map" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></>}
  {name === "facebook" && <path d="M14 8.5h2.5v-4H14a4 4 0 0 0-4 4v2.5H7.5v4H10v6h4v-6h2.5l.5-4h-3V9a.5.5 0 0 1 .5-.5Z" />}
  {name === "arrow" && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === "arrow-down" && <path d="M12 4v15m-5-5 5 5 5-5" />}
  {name === "crown" && <path d="M3.5 17.5h17M4 15 3 7l5 3.5L12 4l4 6.5L21 7l-1 8Z" fill="currentColor" stroke-width="1" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "chevron" && <path d="m6 9 6 6 6-6" />}
</svg>
